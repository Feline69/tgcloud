# Obtén API_ID y API_HASH en https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Genera este valor ejecutando: node setup.js
TG_SESSION=

# ID o username del canal/chat privado donde se guardarán los archivos
# Ejemplo: -1001234567890  o  @mi_canal_privado
TG_CHAT=

# Usuario y contraseña del admin inicial (se crea automáticamente si no hay usuarios)
ADMIN_USER=admin
ADMIN_PASSWORD=
